# Copy this file to `.env` (same folder) and fill in your real values.
# The dashboard auto-loads .env on startup, so you don't need to use
# `export` (Linux/Mac) or `$env:` (PowerShell) at all.
#
# After editing .env, restart the dashboard:  npm run dashboard
#
# .env is in .gitignore — your secrets stay local.

# --- BrowserStack (for npm run test:bs and the dashboard's BrowserStack mode) ---
BROWSERSTACK_USERNAME=your_browserstack_username
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key

# Optional:
# BROWSERSTACK_BUILD=release-2026-05
# BROWSERSTACK_PROJECT=Webflow Sites Testing
# BS_WORKERS=2

# --- Lighthouse thresholds (optional overrides) ---
# LH_MIN_PERF=80
# LH_MIN_A11Y=95
# LH_MIN_BP=90
# LH_MIN_SEO=95

# --- Dashboard server port (default 3000) ---
# PORT=3000

# --- Dashboard authentication (optional, recommended when sharing) -----------
# If TFWEFLOLAB_PASS is set, the dashboard requires HTTP Basic Auth before
# any page or API loads. If unset, the server runs without a password (same
# behaviour as before — fine for "just me on my laptop").
#
# Single shared credential for the whole QA team:
#   1. Pick a password, share it with teammates via your team chat.
#   2. Set both lines below.
#   3. Restart `npm run dashboard`.
#   4. Browser will show a username/password prompt on first visit.
# TFWEFLOLAB_USER=tfweflolab
# TFWEFLOLAB_PASS=change-this-to-a-real-password

# --- Bind host for LAN sharing (optional) ------------------------------------
# Default: server listens only on 127.0.0.1 (your machine only).
# Set TFWEFLOLAB_LAN=1 to listen on 0.0.0.0 so colleagues on the same Wi-Fi
# can reach you at http://<your-IP>:3000 (the startup banner prints the URL).
# Combine with TFWEFLOLAB_PASS above so the LAN endpoint isn't open.
# TFWEFLOLAB_LAN=1
